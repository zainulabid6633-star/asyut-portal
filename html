/* ===== Global click animation system ===== */
(function initClickAnimations() {
  document.addEventListener('click', function(e) {
    const target = e.target.closest(
      'button, .wing-item, .stat-card, .achievement-card, .profile-pic, .profile-pic-placeholder, .view-profile-btn, .save-row-btn'
    );

    // Ripple from the exact click position
    if (target) {
      const ripple = document.createElement('span');
      ripple.className = 'ripple';
      ripple.style.left = e.clientX + 'px';
      ripple.style.top = e.clientY + 'px';
      document.body.appendChild(ripple);
      setTimeout(() => ripple.remove(), 600);

      // Small click-pop animation
      target.classList.remove('click-animate');
      void target.offsetWidth;
      target.classList.add('click-animate');

      // Extra visual feedback for sidebar class selection
      if (target.closest('.wing-item')) {
        const item = target.closest('.wing-item');
        item.classList.remove('click-selected');
        void item.offsetWidth;
        item.classList.add('click-selected');
      }

      // Button glow
      if (target.matches('button')) {
        target.classList.remove('clicked');
        void target.offsetWidth;
        target.classList.add('clicked');
        setTimeout(() => target.classList.remove('clicked'), 500);
      }
    }
  }, true);

  // Animate dynamically-rendered modals/panels too
  const observer = new MutationObserver(() => {
    document.querySelectorAll('.modal-content:not([data-animated]), .content-panel > *:not([data-animated])')
      .forEach(el => {
        el.dataset.animated = 'true';
      });
  });
  observer.observe(document.body, { childList: true, subtree: true });
})();

 
